# Copy this file to .env and fill in the values.

# Telegram bot token from @BotFather. Leave empty to run without Telegram.
TELEGRAM_BOT_TOKEN=

# Only when the dashboard is reached through another address, e.g. hosted behind
# HTTPS with Tailscale or on your own domain with a Cloudflare Tunnel (see HOSTING.md):
# DASHBOARD_URL=https://roomfinder.example.com     # used in invite links from the CLI
# ALLOWED_HOSTS=["roomfinder.example.com"]         # host names the dashboard answers to
# COOKIE_SECURE=true                               # sign-in cookie over HTTPS only

# The dashboard on your own domain through a Cloudflare Tunnel (see HOSTING.md).
# The token is a secret: it lets whoever holds it serve your domain.
# COMPOSE_PROFILES=tunnel
# CLOUDFLARE_TUNNEL_TOKEN=
